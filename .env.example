# ==============================================================================
# MikroTik AI Agent Automation - Environment Configuration (.env.example)
# Salin file ini menjadi .env dan sesuaikan dengan konfigurasi Anda.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Telegram Bot & Whitelist RBAC
# ------------------------------------------------------------------------------
# Token bot dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ

# Whitelist pengguna yang diizinkan berinteraksi dengan bot (dipisahkan koma)
# Cek ID Telegram Anda via bot @userinfobot
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Role Administrator: Memiliki hak penuh (Read & Write Konfigurasi)
ADMIN_TELEGRAM_IDS=123456789

# Role Viewer: Hanya memiliki hak pemantauan (Read-Only)
VIEWER_TELEGRAM_IDS=987654321

# ------------------------------------------------------------------------------
# 2. AI Agent & LLM Configuration
# ------------------------------------------------------------------------------
# Provider: gemini | openai | openrouter | ollama | heuristic
LLM_PROVIDER=gemini

# Model yang digunakan (contoh: gemini-2.5-flash, gpt-4o-mini)
LLM_MODEL=gemini-2.5-flash

# API Key Google Gemini (dapatkan di https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_api_key_here

# API Key OpenAI / OpenRouter (opsional jika menggunakan provider OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 3. MikroTik Router Defaults & Resilience
# ------------------------------------------------------------------------------
# Nama router default yang digunakan jika user tidak menyebutkan lokasi
DEFAULT_MIKROTIK_DEVICE=Kantor Utama

# Aktifkan simulasi fallback otomatis jika router fisik sedang offline
ENABLE_MOCK_FALLBACK=true

# Batas waktu tunggu persetujuan tombol konfirmasi dalam detik (default: 300s = 5 menit)
CONFIRMATION_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------------------
# 4. Proactive Monitoring & Alerting
# ------------------------------------------------------------------------------
# Aktifkan background watchdog pemantau kesehatan router otomatis
MONITORING_ENABLED=true

# Interval polling pengecekan status router dalam detik
MONITORING_INTERVAL_SECONDS=60

# Ambang batas beban CPU (%) untuk mengirimkan peringatan otomatis
CPU_THRESHOLD_PERCENT=90.0

# ID Chat/Grup Telegram target pengiriman notifikasi otomatis jika ada router down
ALERT_TELEGRAM_CHAT_ID=123456789

# ------------------------------------------------------------------------------
# 5. Database & Audit Trail Storage
# ------------------------------------------------------------------------------
DATABASE_PATH=data/audit.db
LOG_FILE_PATH=logs/audit.jsonl
